migration_rate = mig_rates,
probability_adaptation = prob_adaptation
)
print(results)
#This is where plotting starts.
# Display both plots side by side
par(mfrow = c(1, 2))
# Plot 1: Migration rate vs probability of adaptation
plot(
mig_rates * 100, prob_adaptation,
type = "b", pch = 16, ylim = c(0, 1),
xlab = "Migration rate (%)",
ylab = "Probability of adaptation",
main = "Migration and Adaptation"
)
# Plot 2: Population size over generations
generation <- 0:(nrow(output) - 1)
total <- output[, "a"] + output[, "A"]
plot(
generation, total,
type = "l", col = "black",
ylim = c(0, max(c(total, recovery_threshold))),
xlab = "Generation",
ylab = "Population size",
main = "Population Dynamics"
)
lines(generation, output[, "a"], col = "blue")
lines(generation, output[, "A"], col = "red")
abline(h = recovery_threshold, col = "darkgreen", lty = 2)
par(mfrow = c(1, 1))
