# Define baseline model parameters
N_init_a <- 100
N_init_A <- 0
N_source_A <- 100
decay_rate <- 0.01
sel_coeff <- 0.2
mut_rate <- 0.0001
t_max <- 1000
mig_rate <- 0.5
output <- simulate_pop(N_init_a, N_init_A, decay_rate, sel_coeff, mut_rate, t_max, mig_rate, N_source_A)
# Run simulations for different migration rates
mig_rates <- seq(0, 0.05, by = 0.01)
# Number of simulations for each migration rate
n_replicates <- 100
# Store probability of adaptation
prob_adaptation <- numeric(length(mig_rates))
# Define population recovery threshold
recovery_threshold <- 1.5 * (N_init_a + N_init_A)
for (j in seq_along(mig_rates)) {
# Store whether adaptation succeeds in each simulation
successes <- logical(n_replicates)
for (r in seq_len(n_replicates)) {
output <- simulate_pop(
N_init_a, N_init_A, decay_rate, sel_coeff,
mut_rate, t_max,
mig_rate = 0.05,
N_source_A = N_source_A
)
# Calculate total population on the warming beach
home_total <- output[, "a"] + output[, "A"]
# Success means population recovery with adapted turtles present
successes[r] <- any(
home_total >= recovery_threshold &
output[, "A"] > 0
)
}
# Probability = successful simulations / total simulations
prob_adaptation[j] <- mean(successes)
}
# Display results
results <- data.frame(
migration_rate = mig_rates,
probability_adaptation = prob_adaptation
)
print(results)
#This is where plotting starts.
# Choose one migration rate for the population trajectory
plot_mig_rate <- 0.05
# Run one population simulation at this migration rate
output <- simulate_pop(
N_init_a, N_init_A, decay_rate, sel_coeff,
mut_rate, t_max,
mig_rate = plot_mig_rate,
N_source_A = N_source_A
)
# Display the final recorded generations
print(tail(output))
# Calculate the generation numbers
x_range <- 0:(nrow(output) - 1)
# Calculate the total local population
total_population <- output[, "a"] + output[, "A"]
# Make sure the recovery threshold is visible on the y-axis
y_max <- max(c(total_population, recovery_threshold))
# Plot the total local population
plot(
x_range, total_population,
type = "l",
col = "black",
lwd = 2,
ylim = c(0, y_max),
xlab = "Generation",
ylab = "Population size",
main = "Population Dynamics on the Warming Beach"
)
# Add the non-adapted turtles
lines(
x_range, output[, "a"],
col = "blue",
lwd = 2
)
# Add the adapted turtles
lines(
x_range, output[, "A"],
col = "red",
lwd = 2
)
# Add the recovery threshold
abline(
h = recovery_threshold,
col = "darkgreen",
lty = 2,
lwd = 2
)
# Explain the meaning of each line
legend(
"topright",
legend = c(
"Total population (a + A)",
"Non-adapted turtles (a)",
"Adapted turtles (A)",
"Recovery threshold (150)"
),
col = c("black", "blue", "red", "darkgreen"),
lty = c(1, 1, 1, 2),
lwd = 2,
bty = "n",
cex = 0.8
)
results <- data.frame(
migration_rate = mig_rates,
probability_adaptation = prob_adaptation
)
print(results)
